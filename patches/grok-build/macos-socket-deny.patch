+#[cfg(target_os = "macos")]
+#[test]
+fn materialized_socket_symlink_denies_alias_and_real_socket() {
+    let root = temp_runtime_root("real-socket-symlink");
+    let target = root.join("real.sock");
+    let alias = root.join("docker.sock");
+    let _listener = std::os::unix::net::UnixListener::bind(&target).unwrap();
+    std::os::unix::fs::symlink(&target, &alias).unwrap();
+    let paths = materialize_runtime_socket_deny_paths_from([alias.clone()]).unwrap();
+    assert!(paths.contains(&dunce::canonicalize(&target).unwrap()));
+    assert!(paths.contains(&dunce::canonicalize(&root).unwrap().join("docker.sock")));
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[cfg(target_os = "macos")]
+#[test]
+fn dangling_socket_symlink_retains_denies() {
+    let root = temp_runtime_root("dangling");
+    let alias = root.join("docker.sock");
+    std::os::unix::fs::symlink("real.sock", &alias).unwrap();
+    let paths = materialize_runtime_socket_deny_paths_from([alias]).unwrap();
+    let canonical_root = dunce::canonicalize(&root).unwrap();
+    assert!(paths.contains(&canonical_root.join("real.sock")));
+    assert!(paths.contains(&canonical_root.join("docker.sock")));
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[cfg(target_os = "macos")]
+#[test]
+fn socket_symlink_to_regular_file_remains_rejected() {
+    let root = temp_runtime_root("not-socket");
+    std::fs::write(root.join("file"), "control").unwrap();
+    let alias = root.join("docker.sock");
+    std::os::unix::fs::symlink("file", &alias).unwrap();
+    assert!(materialize_runtime_socket_deny_paths_from([alias]).is_err());
+    std::fs::remove_dir_all(root).unwrap();
+}
