+use xai_grok_sandbox::{ProfileName, SandboxManager};
+use std::os::unix::net::{UnixListener, UnixStream};
+fn main() {
+    let workspace = std::path::PathBuf::from(format!("/private/tmp/grok-check-{}", std::process::id()));
+    let home = workspace.join("home");
+    let socket_dir = home.join(".docker/run");
+    std::fs::create_dir_all(&socket_dir).unwrap();
+    let target = workspace.join("real.sock");
+    let alias = socket_dir.join("docker.sock");
+    let _listener = UnixListener::bind(&target).unwrap();
+    std::os::unix::fs::symlink(&target, &alias).unwrap();
+    // This standalone test has no other threads or reads of environment yet.
+    unsafe { std::env::set_var("HOME", &home); std::env::set_var("GROK_HOME", home.join(".grok")); }
+    let mut sandbox = SandboxManager::new(ProfileName::Strict, &workspace);
+    sandbox.apply(&workspace).unwrap();
+    assert!(sandbox.is_applied());
+    for path in [&alias, &target] {
+        match UnixStream::connect(path) {
+            Err(e) if e.kind() == std::io::ErrorKind::PermissionDenied => println!("socket denied"),
+            Err(e) => panic!("unproven denial: {e}"),
+            Ok(_) => panic!("socket protection missing"),
+        }
+        assert!(std::fs::remove_file(path).is_err(), "denied socket can be unlinked");
+        assert!(std::fs::rename(path, workspace.join("moved.sock")).is_err(), "denied socket can be renamed");
+    }
+    std::fs::write(workspace.join("allowed.txt"), "control").unwrap();
+    println!("strict active: connections and mutation denied for alias and target; workspace write allowed");
+}
