# Login and Cloud Chat use https://douchat.ai by default, so a fresh checkout
# can sign in with a douchat.ai account. Set this only to develop against your
# own Douchat service; the model API is read from <origin>/v1. Packaged builds
# ignore this override and always use https://douchat.ai.
# DOUCHAT_SERVICE_URL=http://localhost:3000
# DOUCHAT_WEB_URL is retained as a backwards-compatible alias.

# Optional advanced fallback for tests or a signed-out scripted runtime. A
# signed-in Douchat account always uses the first-party Cloud Chat API instead.
GATEWAY_BASE_URL=http://localhost:8080/api/v1
GATEWAY_API_KEY=

# Without a gateway, a first-party provider key also brings bots online.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
